<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ subject }}</title>
<style type="text/css">
  @media (prefers-color-scheme: dark) {
    .em-bg      { background-color: #111827 !important; }
    .em-card    { background-color: #1f2937 !important; }
    .em-hdr     { background-color: #0d1117 !important; }
    .em-str     { color: #f9fafb !important; }
    .em-txt     { color: #d1d5db !important; }
    .em-muted   { color: #9ca3af !important; }
    .em-lnk     { color: #60a5fa !important; }
    .em-rule    { border-bottom-color: #374151 !important; }
    .em-div     { border-bottom-color: #374151 !important; }
    .em-ftr     { background-color: #111827 !important; border-top-color: #374151 !important; }
    .em-badge   { background-color: #312e81 !important; color: #a5b4fc !important; }
    .em-metric  { background-color: #1e2a3a !important; border-color: #374151 !important; }
    .em-metric-val { color: #f9fafb !important; }
    .em-metric-lbl { color: #9ca3af !important; }
  }
</style>
</head>
<body style="margin:0; padding:0; background-color:#f4f5f7; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">

  {% if preheader %}
  <div style="display:none; max-height:0; overflow:hidden; mso-hide:all;">{{ preheader }}</div>
  {% endif %}

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="em-bg" style="background-color:#f4f5f7;">
    <tr>
      <td align="center" style="padding: 24px 16px;">

        <table role="presentation" width="600" cellpadding="0" cellspacing="0" class="em-card" style="width:600px; max-width:600px; background-color:#ffffff; border-radius:8px; overflow:hidden;">

          <!-- Header bar -->
          <tr>
            <td class="em-hdr" style="background-color:#1a1f2e; padding:20px 28px;">
              {% if logo_url %}
              <img src="{{ logo_url }}" alt="{{ logo_alt }}" height="32" border="0" style="display:block; margin-bottom:10px; max-width:160px; height:32px;">
              {% endif %}
              <span style="color:#ffffff; font-size:18px; font-weight:600; letter-spacing:0.2px;">{{ subject }}</span>
              {% if period %}
              <br><span style="color:#9ba5b7; font-size:12px; margin-top:4px; display:block;">{{ period }}</span>
              {% endif %}
            </td>
          </tr>

          {% if intro %}
          <tr>
            <td style="padding:20px 28px 4px 28px;">
              <p class="em-txt" style="margin:0; color:#444444; font-size:14px; line-height:1.5;">{{ intro }}</p>
            </td>
          </tr>
          {% endif %}

          <!-- Metrics grid (2 per row, max 4) -->
          <tr>
            <td style="padding:20px 28px 8px 28px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                {% for pair in metrics | batch(2) %}
                <tr>
                  {% for metric in pair %}
                  <td class="em-metric" width="{% if pair|length == 2 %}48%{% else %}100%{% endif %}" style="background-color:#f0f4ff; border:1px solid #dde3f0; border-radius:6px; padding:14px 16px; vertical-align:top; {% if not loop.last %}padding-right:8px;{% endif %}">
                    <p class="em-metric-lbl" style="margin:0 0 4px 0; color:#6b7280; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px;">{{ metric.label }}</p>
                    <p class="em-metric-val" style="margin:0 0 {% if metric.delta %}4px{% else %}0{% endif %} 0; color:#1a1f2e; font-size:26px; font-weight:700; line-height:1.1;">{{ metric.value }}</p>
                    {% if metric.delta %}
                      {% set sentiment = metric.delta_sentiment or "neutral" %}
                      {% if sentiment == "positive" %}
                        {% set delta_color = "#16a34a" %}
                        {% set delta_icon  = "&#9650;" %}
                      {% elif sentiment == "negative" %}
                        {% set delta_color = "#dc2626" %}
                        {% set delta_icon  = "&#9660;" %}
                      {% else %}
                        {% set delta_color = "#6b7280" %}
                        {% set delta_icon  = "&mdash;" %}
                      {% endif %}
                    <p style="margin:0; color:{{ delta_color }}; font-size:12px; font-weight:600;">{{ delta_icon }} {{ metric.delta }}</p>
                    {% endif %}
                  </td>
                  {% if not loop.last %}
                  <td width="4%" style="padding:0;"></td>
                  {% endif %}
                  {% endfor %}
                  {% if pair|length == 1 %}
                  <td width="48%"></td>
                  {% endif %}
                </tr>
                {% if not loop.last %}<tr><td colspan="3" style="padding-bottom:8px;"></td></tr>{% endif %}
                {% endfor %}
              </table>
            </td>
          </tr>

          <!-- Highlights (optional) -->
          {% if highlights %}
          <tr>
            <td style="padding: 16px 28px 4px 28px;">
              <p class="em-str em-rule" style="margin:0 0 4px 0; color:#1a1f2e; font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:0.6px; border-bottom:2px solid #e8eaed; padding-bottom:8px;">Highlights</p>
            </td>
          </tr>
          {% for highlight in highlights %}
          <tr>
            <td class="em-div" style="padding: 12px 28px; {% if not loop.last %}border-bottom:1px solid #f0f1f3;{% endif %}">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="vertical-align:top; width:20px; padding-top:1px;">
                    <span class="em-lnk" style="color:#1a56db; font-size:16px; font-weight:700; line-height:1.3;">&#8227;</span>
                  </td>
                  <td style="vertical-align:top;">
                    <p class="em-txt" style="margin:0; color:#333333; font-size:13.5px; line-height:1.5;">
                      {{ highlight.text }}
                      {% if highlight.tag %}
                      <span class="em-badge" style="display:inline-block; margin-left:6px; padding:2px 7px; background-color:#eef2ff; color:#4338ca; font-size:11px; font-weight:600; border-radius:10px; text-transform:uppercase; vertical-align:middle;">{{ highlight.tag }}</span>
                      {% endif %}
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {% endfor %}
          {% endif %}

          <!-- Detail sections (optional) -->
          {% for section in sections %}
          <tr>
            <td style="padding: 16px 28px 4px 28px;">
              <p class="em-str em-rule" style="margin:0 0 4px 0; color:#1a1f2e; font-size:13px; font-weight:700; text-transform:uppercase; letter-spacing:0.6px; border-bottom:2px solid #e8eaed; padding-bottom:8px;">
                {{ section.heading }}
              </p>
            </td>
          </tr>
          {% for item in section['items'] %}
          <tr>
            <td style="padding: 4px 28px 4px 40px;">
              <p class="em-txt" style="margin:0; color:#555555; font-size:13px; line-height:1.5;">&#8226; {{ item }}</p>
            </td>
          </tr>
          {% endfor %}
          {% endfor %}

          <!-- Spacer before footer -->
          <tr><td style="padding-bottom:16px;"></td></tr>

          <!-- Footer -->
          <tr>
            <td class="em-ftr" style="padding: 20px 28px; background-color:#fafafa; border-top:1px solid #eeeeee;">
              <p class="em-muted" style="margin:0; color:#9aa0a6; font-size:12px; line-height:1.5;">
                {% if footer_note %}{{ footer_note }}<br>{% endif %}
                Generated automatically by Orchid &middot; {{ generated_at }} &middot; v{{ server_version }}
                {% if unsubscribe_url %}
                <br><a href="{{ unsubscribe_url }}" class="em-muted" style="color:#9aa0a6; text-decoration:underline; font-size:11px;">Unsubscribe</a>
                {% endif %}
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
