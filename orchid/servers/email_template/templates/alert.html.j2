<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ subject }}</title>
<style type="text/css">
  @media (prefers-color-scheme: dark) {
    .em-bg    { background-color: #111827 !important; }
    .em-card  { background-color: #1f2937 !important; }
    .em-str   { color: #f9fafb !important; }
    .em-txt   { color: #d1d5db !important; }
    .em-muted { color: #9ca3af !important; }
    .em-ftr   { background-color: #111827 !important; border-top-color: #374151 !important; }
    .em-ac    { background-color: #1f2937 !important; }
  }
</style>
</head>
<body style="margin:0; padding:0; background-color:#f4f5f7; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">

  {% if preheader %}
  <div style="display:none; max-height:0; overflow:hidden; mso-hide:all;">{{ preheader }}</div>
  {% endif %}

  {# Per-level colour tokens #}
  {% if alert_level == "error" %}
    {% set accent      = "#b91c1c" %}
    {% set accent_light = "#fef2f2" %}
    {% set accent_text  = "#991b1b" %}
    {% set label       = "ERROR" %}
  {% elif alert_level == "warning" %}
    {% set accent      = "#b45309" %}
    {% set accent_light = "#fffbeb" %}
    {% set accent_text  = "#92400e" %}
    {% set label       = "WARNING" %}
  {% elif alert_level == "success" %}
    {% set accent      = "#15803d" %}
    {% set accent_light = "#f0fdf4" %}
    {% set accent_text  = "#14532d" %}
    {% set label       = "SUCCESS" %}
  {% else %}
    {% set accent      = "#1d4ed8" %}
    {% set accent_light = "#eff6ff" %}
    {% set accent_text  = "#1e3a8a" %}
    {% set label       = "INFO" %}
  {% endif %}

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="em-bg" style="background-color:#f4f5f7;">
    <tr>
      <td align="center" style="padding: 24px 16px;">

        <table role="presentation" width="600" cellpadding="0" cellspacing="0" class="em-card" style="width:600px; max-width:600px; background-color:#ffffff; border-radius:8px; overflow:hidden;">

          <!-- Coloured header bar (accent colour stays in dark mode — intentional) -->
          <tr>
            <td style="background-color:{{ accent }}; padding:20px 28px;">
              {% if logo_url %}
              <img src="{{ logo_url }}" alt="{{ logo_alt }}" height="32" border="0" style="display:block; margin-bottom:10px; max-width:160px; height:32px;">
              {% endif %}
              <span style="color:#ffffff; font-size:11px; font-weight:700; letter-spacing:1px; text-transform:uppercase; opacity:0.85;">{{ label }}</span><br>
              <span style="color:#ffffff; font-size:18px; font-weight:600; letter-spacing:0.2px;">{{ subject }}</span>
            </td>
          </tr>

          <!-- Headline -->
          <tr>
            <td class="em-ac" style="padding:24px 28px 8px 28px; background-color:{{ accent_light }}; border-left:4px solid {{ accent }};">
              <p class="em-str" style="margin:0; color:{{ accent_text }}; font-size:20px; font-weight:700; line-height:1.3;">{{ headline }}</p>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td class="em-ac" style="padding:16px 28px {% if not details and not cta_text %}24px{% else %}8px{% endif %} 28px; background-color:{{ accent_light }}; border-left:4px solid {{ accent }};">
              <p class="em-txt" style="margin:0; color:#374151; font-size:14.5px; line-height:1.65;">{{ body }}</p>
            </td>
          </tr>

          <!-- Details list (optional) -->
          {% if details %}
          <tr>
            <td class="em-ac" style="padding:0 28px {% if not cta_text %}20px{% else %}8px{% endif %} 28px; background-color:{{ accent_light }}; border-left:4px solid {{ accent }};">
              <table role="presentation" cellpadding="0" cellspacing="0">
                {% for fact in details %}
                <tr>
                  <td style="vertical-align:top; padding-right:8px; color:{{ accent_text }}; font-size:13px; font-weight:700;">&#8250;</td>
                  <td class="em-txt" style="color:#4b5563; font-size:13px; line-height:1.5; padding-bottom:4px;">{{ fact }}</td>
                </tr>
                {% endfor %}
              </table>
            </td>
          </tr>
          {% endif %}

          <!-- CTA button (optional) -->
          {% if cta_text and cta_url %}
          <tr>
            <td class="em-ac" style="padding:12px 28px 20px 28px; background-color:{{ accent_light }}; border-left:4px solid {{ accent }};">
              <table role="presentation" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="background-color:{{ accent }}; border-radius:6px;">
                    <a href="{{ cta_url }}" style="display:inline-block; padding:10px 20px; color:#ffffff; font-size:13px; font-weight:600; text-decoration:none; letter-spacing:0.2px;">{{ cta_text }}</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {% endif %}

          <!-- Footer -->
          <tr>
            <td class="em-ftr" style="padding: 20px 28px; background-color:#fafafa; border-top:1px solid #eeeeee;">
              <p class="em-muted" style="margin:0; color:#9aa0a6; font-size:12px; line-height:1.5;">
                {% if footer_note %}{{ footer_note }}<br>{% endif %}
                Generated automatically by Orchid &middot; {{ generated_at }} &middot; v{{ server_version }}
                {% if unsubscribe_url %}
                <br><a href="{{ unsubscribe_url }}" class="em-muted" style="color:#9aa0a6; text-decoration:underline; font-size:11px;">Unsubscribe</a>
                {% endif %}
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
